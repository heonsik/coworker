{
  "name": "@accomplish/daemon",
  "version": "0.1.0",
  "private": true,
  "description": "Accomplish background daemon process",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup && node scripts/write-dist-package-type.cjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest watch",
    "clean": "node -e \"import('fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\""
  },
  "dependencies": {
    "@accomplish_ai/agent-core": "workspace:*",
    "@opencode-ai/sdk": "1.14.18",
    "@whiskeysockets/baileys": "7.0.0-rc.9",
    "better-sqlite3": "^13.0.3",
    "pino": "^10.3.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.5.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
